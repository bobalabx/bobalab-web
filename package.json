{
  "name": "bobalab-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --preview",
    "start": "node scripts/serve-out.mjs",
    "serve:out": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "validate": "vitest run --config vitest.content.config.ts",
    "e2e": "playwright test",
    "media": "node scripts/media/build-images.mjs",
    "media:check": "node scripts/media/build-images.mjs --check",
    "import:content": "node scripts/import/import-dataset.mjs",
    "cms:local": "node scripts/cms/local.mjs",
    "cms:config": "node scripts/cms/build-config.mjs",
    "cms:check": "node scripts/cms/build-config.mjs --check",
    "cms:vendor": "node scripts/cms/vendor-decap.mjs",
    "cms:vendor:check": "node scripts/cms/vendor-decap.mjs --check",
    "perf": "node scripts/perf/js-budget.mjs",
    "perf:assets": "node scripts/perf/asset-budget.mjs",
    "check:export": "node scripts/perf/export-check.mjs",
    "lighthouse": "node scripts/perf/lighthouse.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "slugs:record": "node scripts/content/record-published-slugs.mjs",
    "brand:wordmark": "python scripts/brand/build-wordmark.py"
  },
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@markdoc/markdoc": "0.5.10",
    "minisearch": "7.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "schema-dts": "2.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "decap-server": "3.11.5",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "lighthouse": "13.5.0",
    "linkinator": "8.1.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
